# Preferred on Hostinger: Microsoft Graph sendMail (port 25 SMTP relay is blocked).
# MAIL_FROM must be a real mailbox (create noreply@ or use info@zenium.ai).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MAIL_FROM=noreply@zenium.ai
MAIL_SENDER=noreply@zenium.ai
MAIL_INTERNAL_TO=info@zenium.ai
MAIL_BCC=

# Local/fallback Microsoft 365 SMTP Relay (IP-based). Hostinger Node cannot use this.
SMTP_HOST=zenium-ai.mail.protection.outlook.com
SMTP_PORT=25

# Analytics (loaded only after cookie consent)
# Prefer GTM; configure GA4 inside the GTM container.
NEXT_PUBLIC_GTM_ID=
# Fallback if GTM is not set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Hostinger MySQL (CMS admin). Quote passwords that contain $ or #.
# CMS login is admin@example.com (seed), not DB_USER.
DB_HOST=
DB_PORT=3306
DB_NAME=zenium_ai
DB_USER=
DB_PASSWORD=

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.zenium.ai
